# Per-function defaults for scripts/deploy.sh, invoke.sh and undeploy.sh.
# Every value here can still be overridden with a --flag (see scripts/README.md).
FUNCTION_NAME=lambda-hello-world
RUNTIME=python3.13
ARCHITECTURE=arm64
HANDLER=lambda_function.lambda_handler
MEMORY_SIZE=128
TIMEOUT=10
ROLE_NAME=lambda-hello-world-role
LAMBDA_ENV_VARS="GREETING=Hello,LOG_LEVEL=INFO"
